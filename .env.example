# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit real secrets.

# Long random string TradingView must include in its webhook URL:
# https://<your-vps-host>/webhook/<this value>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Master switch. Leave false until you've validated paper-trading results.
LIVE_TRADING=false

# Only needed when LIVE_TRADING=true. Create a Kraken API key with "Query
# Funds" + "Create & Modify Orders" permission ONLY -- never grant Withdraw.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Paper-trading simulator's starting balance (USD). Ignored when LIVE_TRADING=true.
PAPER_STARTING_BALANCE=1000

# Fraction of current equity risked on each trade. 1.0 = 100% of the account
# per trade (high risk -- the strategy was backtested at ~12%, see README).
POSITION_SIZE_FRACTION=1.0

# Kraken Spot can't short. Leave false unless you've set up Kraken margin
# trading and accept the added risk (margin calls, liquidation, borrow cost)
# -- margin order execution isn't implemented yet even if you flip this on.
ALLOW_SHORTS=false

# ATR bracket -- match these to whatever you set in the Pine script's own
# "ATR Bracket Exit" group so live behavior matches the backtest.
STOP_ATR_MULT=1.5
TARGET_ATR_MULT=2.0
BREAKEVEN_ATR_MULT=1.0
USE_BREAKEVEN=true
BAR_MINUTES=1
MAX_BARS_IN_TRADE=12

POLL_INTERVAL_SECONDS=5
