// VWAP Deviation Reversion Strategy
//
// Strategy conversion of a volume-weighted deviation-band mean-reversion
// indicator. The core calculation, band logic, RSI/volume/regime filters,
// and session breakdown are carried over unchanged from the source
// indicator; a stop/target/position-sizing layer has been added on top to
// turn its "opportunity" signals into real trades.
//
// Core idea: compute a rolling, volume-weighted mean of price over a fixed
// lookback window (not a session-anchored VWAP - it never resets, it just
// rolls forward), plus bands built from the volume-weighted MEAN ABSOLUTE
// DEVIATION around that mean (not standard deviation, despite the "sigma"
// naming). Price reaching a 2-sigma or 3-sigma band, together with an RSI
// extreme, above-average volume, and a market-regime check (avoid fading a
// strong trend against you), is read as an overextension likely to revert
// back toward the mean.
//
//   Entry:  band touch (2-sigma or 3-sigma) + RSI overbought/oversold +
//           volume filter + regime filter.
//   Stop:   a fixed ATR multiple beyond entry.
//   Target: the current rolling mean by default (a genuine mean-reversion
//           target that moves with the mean each bar until hit), or a
//           fixed reward multiple of the initial risk instead.
//
// Position sizing is risk-based (a fixed % of equity divided by the trade's
// actual stop distance) rather than a flat share/contract count.
//
// Session buckets (Asian/London/New York) use the chart's own timezone via
// hour(time) - if your chart's timezone isn't set to what you expect, these
// buckets will read wrong. Set the chart's timezone to UTC for the hour
// ranges below to match the usual FX session definitions.
//
// NON-REPAINTING: calc_on_every_tick is disabled - every signal locks in at
// bar close.
//
// Past performance in the Strategy Tester is hypothetical and not
// indicative of future results. Research/education tool only, not
// financial advice.

//@version=6
strategy("VWAP Deviation Reversion", shorttitle="VWAPDev", overlay=true,
     calc_on_every_tick=false, process_orders_on_close=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     initial_capital=25000, commission_type=strategy.commission.cash_per_order,
     commission_value=0, slippage=1, max_labels_count=500)

// ---- Inputs ----

group_core = "Core Settings"
ls = input.bool(true, title="Log-space Scaling", tooltip="Enable proportional scaling with price axis", group=group_core)
length = input.int(60, title="VWAP Length", group=group_core)
source = input.source(close, title="Source", group=group_core)
dev2Mult = input.float(2.0, title="2-sigma Multiplier", minval=0.1, step=0.1, group=group_core)
dev3Mult = input.float(3.0, title="3-sigma Multiplier", minval=0.1, step=0.1, group=group_core)

group_signals = "Signal Settings"
rsiLength = input.int(14, title="RSI Length", minval=2, maxval=50, group=group_signals)
rsiOverbought = input.float(70, title="RSI Overbought", minval=60, maxval=90, group=group_signals)
rsiOversold = input.float(30, title="RSI Oversold", minval=10, maxval=40, group=group_signals)
useVolumeFilter = input.bool(true, title="Volume Filter", tooltip="Require above-average volume", group=group_signals)
volumeMultiplier = input.float(1.2, title="Volume Threshold", minval=0.5, maxval=3.0, step=0.1, group=group_signals)

group_advanced = "Advanced Features"
showSessionStats = input.bool(true, title="Session Statistics", tooltip="Track signal counts by trading session", group=group_advanced)
showDivergence = input.bool(false, title="RSI Divergence Detection", tooltip="Highlight RSI divergences at band touches", group=group_advanced)
useMarketRegime = input.bool(true, title="Market Type Filter", tooltip="Adapt signals based on trending vs ranging markets", group=group_advanced)

group_entry = "Strategy Entry"
strongOnly = input.bool(false, title="Only trade 3-sigma touches (stricter, fewer trades)", group=group_entry)
requireDivergenceConfluence = input.bool(false, title="Require RSI divergence to enter", group=group_entry,
     tooltip="Off by default, matching the indicator's own base signal. On: only enter when a divergence also confirms the band touch.")
restrictSession = input.string("Any", title="Restrict entries to session", options=["Any", "Asian", "London", "New York"], group=group_entry,
     tooltip="Session buckets depend on the chart's timezone via hour(time) - see the header comment.")

group_risk = "Risk / Sizing"
atrStopLen = input.int(14, title="ATR Length (stop)", minval=1, group=group_risk)
atrStopMult = input.float(1.5, title="Stop Distance (x ATR)", minval=0.1, step=0.1, group=group_risk)
riskPerTradePct = input.float(1.0, title="Risk per trade (% of equity)", minval=0.05, step=0.05, group=group_risk)
useVwapTarget = input.bool(true, title="Target = rolling mean (trails until hit)", group=group_risk,
     tooltip="On: take-profit is the current rolling VWAP mean, updating each bar until price reaches it - the strategy's actual mean-reversion thesis. Off: a fixed reward multiple instead.")
fixedRewardMultiple = input.float(2.0, title="Fallback fixed reward multiple (if mean target off)", minval=0.5, step=0.1, group=group_risk)

group_visual = "Visual Settings"
showVwapLine = input.bool(true, title="Show VWAP Line", group=group_visual)
fillBands = input.bool(true, title="Fill Band Areas", group=group_visual)
showSignals = input.bool(false, title="Show Trade Signals", tooltip="Master toggle - turn ON to see all trade opportunity signals", group=group_visual)
showTradeLevels = input.bool(true, title="Show entry/stop/target lines", group=group_visual)
showDashboard = input.bool(true, title="Show Dashboard", group=group_visual)

group_colors = "Colors"
bullishColor = input.color(#4CAF50, title="Bullish Zone Color", group=group_colors)
bearishColor = input.color(#F44336, title="Bearish Zone Color", group=group_colors)

group_alerts = "Alerts"
enableAlerts = input.bool(true, title="Enable Alerts", group=group_alerts)

// ---- Core VWAP deviation calculations (unchanged from the source indicator) ----

smith_vwmean(x, y) =>
    cw = 0.0
    cd = 0.0
    w_sum = 0.0
    d_sum = 0.0
    for i = 0 to y - 1 by 1
        cd := x[i]
        cw := volume[i]
        d_sum += cw * cd
        w_sum += cw
    d_sum / w_sum

smith_vwavdev(x, y, b) =>
    d_sum = 0.0
    w_sum = 0.0
    cd = 0.0
    for i = 0 to y - 1 by 1
        cd := x[i]
        cw = volume[i]
        d_sum += cw * math.abs(cd - b)
        w_sum += cw
    d_sum / w_sum

src = ls ? math.log(source) : source

vwmean = smith_vwmean(src, length)
dev = smith_vwavdev(src, length, vwmean)

upper2Sigma = vwmean + (dev * dev2Mult)
lower2Sigma = vwmean - (dev * dev2Mult)
upper3Sigma = vwmean + (dev * dev3Mult)
lower3Sigma = vwmean - (dev * dev3Mult)

_upper2Sigma = ls ? math.exp(upper2Sigma) : upper2Sigma
_lower2Sigma = ls ? math.exp(lower2Sigma) : lower2Sigma
_upper3Sigma = ls ? math.exp(upper3Sigma) : upper3Sigma
_lower3Sigma = ls ? math.exp(lower3Sigma) : lower3Sigma
_vwmean = ls ? math.exp(vwmean) : vwmean

// ---- Sessions (see header note on chart timezone) ----

currentHour = hour(time)
isAsian = currentHour >= 21 or currentHour < 8
isLondon = currentHour >= 8 and currentHour < 13
isNY = currentHour >= 13 and currentHour < 21

sessionOk = restrictSession == "Any" or (restrictSession == "Asian" and isAsian) or (restrictSession == "London" and isLondon) or (restrictSession == "New York" and isNY)

// ---- RSI / volume / regime filters ----

rsi = ta.rsi(close, rsiLength)
rsiOverboughtCondition = rsi >= rsiOverbought
rsiOversoldCondition = rsi <= rsiOversold

avgVolume = ta.sma(volume, 20)
volumeQualified = useVolumeFilter ? volume >= (avgVolume * volumeMultiplier) : true

rsiHigh = ta.highest(rsi, 5)
rsiLow = ta.lowest(rsi, 5)
priceHigh = ta.highest(high, 5)
priceLow = ta.lowest(low, 5)
bearishDiv = priceHigh > priceHigh[5] and rsiHigh < rsiHigh[5] and close >= _upper2Sigma
bullishDiv = priceLow < priceLow[5] and rsiLow > rsiLow[5] and close <= _lower2Sigma

ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
atr20 = ta.atr(20)
isTrending = math.abs(ema21 - ema50) > (atr20 * 1.5)
trendDirection = ema21 > ema50 ? 1 : -1
regimeLongOK = useMarketRegime ? (not isTrending or (isTrending and trendDirection > 0)) : true
regimeShortOK = useMarketRegime ? (not isTrending or (isTrending and trendDirection < 0)) : true

// ---- Signal detection ----

upper2Touch = close >= _upper2Sigma and close[1] < _upper2Sigma
lower2Touch = close <= _lower2Sigma and close[1] > _lower2Sigma
upper3Touch = close >= _upper3Sigma and close[1] < _upper3Sigma
lower3Touch = close <= _lower3Sigma and close[1] > _lower3Sigma

longOpportunity = (lower2Touch or lower3Touch) and rsiOversoldCondition and volumeQualified and regimeLongOK
shortOpportunity = (upper2Touch or upper3Touch) and rsiOverboughtCondition and volumeQualified and regimeShortOK
strongLongOpportunity = lower3Touch and rsiOversoldCondition and volumeQualified and regimeLongOK
strongShortOpportunity = upper3Touch and rsiOverboughtCondition and volumeQualified and regimeShortOK

// Visual-only variants: showDivergence affects what is DRAWN, matching the
// source indicator's own behavior, and is independent of what is TRADED.
visLongOpportunity = longOpportunity and (not showDivergence or bullishDiv)
visShortOpportunity = shortOpportunity and (not showDivergence or bearishDiv)
visStrongLongOpportunity = strongLongOpportunity and (not showDivergence or bullishDiv)
visStrongShortOpportunity = strongShortOpportunity and (not showDivergence or bearishDiv)
visRegularLongOpportunity = visLongOpportunity and not visStrongLongOpportunity
visRegularShortOpportunity = visShortOpportunity and not visStrongShortOpportunity

// ---- Entries ----

canEnter = strategy.position_size == 0 and sessionOk
tradeEligibleLong = strongOnly ? strongLongOpportunity : longOpportunity
tradeEligibleShort = strongOnly ? strongShortOpportunity : shortOpportunity

enterLongNow = canEnter and tradeEligibleLong and (not requireDivergenceConfluence or bullishDiv)
enterShortNow = canEnter and tradeEligibleShort and (not requireDivergenceConfluence or bearishDiv)

atrForStop = ta.atr(atrStopLen)

var float entryPrice = na
var float stopPriceFinal = na
var float fixedTargetFinal = na

if enterLongNow
    stopPriceFinal := close - atrForStop * atrStopMult
    riskPerShare = math.max(close - stopPriceFinal, syminfo.mintick)
    riskAmount = strategy.equity * riskPerTradePct / 100
    qty = riskAmount / riskPerShare
    strategy.entry("Long", strategy.long, qty=qty)
    entryPrice := close
    fixedTargetFinal := close + riskPerShare * fixedRewardMultiple

if enterShortNow
    stopPriceFinal := close + atrForStop * atrStopMult
    riskPerShare = math.max(stopPriceFinal - close, syminfo.mintick)
    riskAmount = strategy.equity * riskPerTradePct / 100
    qty = riskAmount / riskPerShare
    strategy.entry("Short", strategy.short, qty=qty)
    entryPrice := close
    fixedTargetFinal := close - riskPerShare * fixedRewardMultiple

targetFinal = useVwapTarget ? _vwmean : fixedTargetFinal

strategy.exit("Long Exit", from_entry="Long", stop=stopPriceFinal, limit=targetFinal)
strategy.exit("Short Exit", from_entry="Short", stop=stopPriceFinal, limit=targetFinal)

// ---- Session signal counts (informational only, not a win-rate claim) ----

var int asianSignals = 0
var int londonSignals = 0
var int nySignals = 0

if showSessionStats and (longOpportunity or shortOpportunity)
    if isAsian
        asianSignals += 1
    else if isLondon
        londonSignals += 1
    else if isNY
        nySignals += 1

// ---- Alerts ----

alertcondition(enableAlerts and enterLongNow, title="Long Trade Opportunity", message="{{ticker}} LONG OPPORTUNITY")
alertcondition(enableAlerts and enterShortNow, title="Short Trade Opportunity", message="{{ticker}} SHORT OPPORTUNITY")
alertcondition(enableAlerts and strongLongOpportunity, title="STRONG Long Opportunity", message="{{ticker}} STRONG LONG")
alertcondition(enableAlerts and strongShortOpportunity, title="STRONG Short Opportunity", message="{{ticker}} STRONG SHORT")
alertcondition(enableAlerts and showDivergence and bullishDiv, title="Bullish Divergence", message="{{ticker}} BULLISH DIVERGENCE")
alertcondition(enableAlerts and showDivergence and bearishDiv, title="Bearish Divergence", message="{{ticker}} BEARISH DIVERGENCE")

if enterLongNow
    alert('{"event":"entry","strategy":"vwapdev","side":"long","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"stop":' + str.tostring(stopPriceFinal) + ',"target":' + str.tostring(targetFinal) + ',"time":"' + str.tostring(time) + '"}', alert.freq_once_per_bar_close)

if enterShortNow
    alert('{"event":"entry","strategy":"vwapdev","side":"short","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"stop":' + str.tostring(stopPriceFinal) + ',"target":' + str.tostring(targetFinal) + ',"time":"' + str.tostring(time) + '"}', alert.freq_once_per_bar_close)

// ---- Plotting ----

vwapLine = plot(showVwapLine ? _vwmean : na, title="VWAP", color=color.new(color.gray, 50), linewidth=1)
upper2Plot = plot(_upper2Sigma, title="Upper 2-sigma", color=bearishColor, linewidth=1)
lower2Plot = plot(_lower2Sigma, title="Lower 2-sigma", color=bullishColor, linewidth=1)
upper3Plot = plot(_upper3Sigma, title="Upper 3-sigma", color=color.new(bearishColor, 20), linewidth=1, display=display.none)
lower3Plot = plot(_lower3Sigma, title="Lower 3-sigma", color=color.new(bullishColor, 20), linewidth=1, display=display.none)

fill(upper2Plot, upper3Plot, color=fillBands ? color.new(bearishColor, 85) : na, title="Upper Zone")
fill(lower2Plot, lower3Plot, color=fillBands ? color.new(bullishColor, 85) : na, title="Lower Zone")

tradeEntryPlot = strategy.position_size != 0 ? entryPrice : na
tradeStopPlot = strategy.position_size != 0 ? stopPriceFinal : na
tradeTargetPlot = strategy.position_size != 0 ? targetFinal : na

plot(showTradeLevels ? tradeEntryPlot : na, "Entry Price", color=color.new(color.gray, 20), style=plot.style_linebr, linewidth=1)
plot(showTradeLevels ? tradeStopPlot : na, "Stop Loss", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(showTradeLevels ? tradeTargetPlot : na, "Take Profit", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)

plotshape(showSignals and visRegularLongOpportunity, title="Long Opportunity", style=shape.circle, location=location.belowbar, color=bullishColor, size=size.normal, text="LONG")
plotshape(showSignals and visRegularShortOpportunity, title="Short Opportunity", style=shape.circle, location=location.abovebar, color=bearishColor, size=size.normal, text="SHORT")
plotshape(showSignals and visStrongLongOpportunity, title="Strong Long", style=shape.diamond, location=location.belowbar, color=bullishColor, size=size.large, text="STRONG\nLONG")
plotshape(showSignals and visStrongShortOpportunity, title="Strong Short", style=shape.diamond, location=location.abovebar, color=bearishColor, size=size.large, text="STRONG\nSHORT")

plotshape(showDivergence and bullishDiv and not (visRegularLongOpportunity or visStrongLongOpportunity), title="Bullish Divergence", style=shape.triangleup, location=location.belowbar, color=color.blue, size=size.small, text="DIV")
plotshape(showDivergence and bearishDiv and not (visRegularShortOpportunity or visStrongShortOpportunity), title="Bearish Divergence", style=shape.triangledown, location=location.abovebar, color=color.purple, size=size.small, text="DIV")

if showTradeLevels and enterLongNow
    label.new(bar_index, stopPriceFinal, "SL " + str.tostring(stopPriceFinal, format.mintick),
         style=label.style_label_down, color=color.new(color.red, 15), textcolor=color.white, size=size.tiny)
    label.new(bar_index, targetFinal, "TP " + str.tostring(targetFinal, format.mintick),
         style=label.style_label_up, color=color.new(color.green, 15), textcolor=color.white, size=size.tiny)

if showTradeLevels and enterShortNow
    label.new(bar_index, stopPriceFinal, "SL " + str.tostring(stopPriceFinal, format.mintick),
         style=label.style_label_up, color=color.new(color.red, 15), textcolor=color.white, size=size.tiny)
    label.new(bar_index, targetFinal, "TP " + str.tostring(targetFinal, format.mintick),
         style=label.style_label_down, color=color.new(color.green, 15), textcolor=color.white, size=size.tiny)

// ---- Dashboard ----

var table dash = table.new(position.bottom_left, 2, 8, bgcolor=color.new(color.gray, 90), border_width=1, border_color=color.gray)

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "Regime", bgcolor=color.gray, text_color=color.white)
    regimeText = isTrending ? (trendDirection > 0 ? "Trending Up" : "Trending Down") : "Ranging"
    table.cell(dash, 1, 0, regimeText,
         bgcolor=isTrending ? (trendDirection > 0 ? color.new(color.green, 60) : color.new(color.red, 60)) : color.new(color.orange, 60))

    table.cell(dash, 0, 1, "Session", bgcolor=color.gray, text_color=color.white)
    sessionText = isAsian ? "Asian" : isLondon ? "London" : "New York"
    table.cell(dash, 1, 1, sessionText)

    table.cell(dash, 0, 2, "RSI", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(rsi, "#.#"),
         bgcolor=rsiOverboughtCondition ? color.new(color.red, 60) : rsiOversoldCondition ? color.new(color.green, 60) : color.new(color.gray, 70))

    table.cell(dash, 0, 3, "Rolling Mean", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(_vwmean, format.mintick))

    table.cell(dash, 0, 4, "Position", bgcolor=color.gray, text_color=color.white)
    posText = strategy.position_size > 0 ? "Long" : strategy.position_size < 0 ? "Short" : "Flat"
    table.cell(dash, 1, 4, posText,
         bgcolor=strategy.position_size > 0 ? color.new(color.green, 60) : strategy.position_size < 0 ? color.new(color.red, 60) : color.new(color.gray, 70))

    if showSessionStats
        table.cell(dash, 0, 5, "Signals: Asian", bgcolor=color.gray, text_color=color.white)
        table.cell(dash, 1, 5, str.tostring(asianSignals))
        table.cell(dash, 0, 6, "Signals: London", bgcolor=color.gray, text_color=color.white)
        table.cell(dash, 1, 6, str.tostring(londonSignals))
        table.cell(dash, 0, 7, "Signals: New York", bgcolor=color.gray, text_color=color.white)
        table.cell(dash, 1, 7, str.tostring(nySignals))

